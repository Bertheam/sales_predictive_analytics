DB_HOST=localhost
DB_PORT=5432
DB_NAME=sales_predictions
DB_USER=postgres
DB_PASSWORD=postgres

# Ports exposés par Docker sur la machine hôte.
POSTGRES_HOST_PORT=5434
STREAMLIT_PORT=8501
DJANGO_PORT=8001

# Réservé au Docker local neuf. Utiliser false sur Railway.
INITIALIZE_DATABASE=true

# Application web Django. Remplacer impérativement la clé en production.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
AUDIT_TRUST_X_FORWARDED_FOR=false
STREAMLIT_PUBLIC_URL=http://localhost:8501
STREAMLIT_SIGNING_KEY=replace-with-a-shared-random-secret
STREAMLIT_REQUIRE_SIGNED_ACCESS=false
STREAMLIT_ACCESS_TOKEN_TTL_SECONDS=300
# Dépôt fixe accessible par le laboratoire Streamlit technique.
STREAMLIT_COMPANY_ID=00000000-0000-4000-8000-000000000001
# Laissez false hors Docker sauf si le rôle PostgreSQL dédié existe.
STREAMLIT_USE_RUNTIME_ROLE=false
TENANT_USE_RUNTIME_ROLE=false

# Invitations d'équipe. Le backend console convient au développement local.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=15
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=NexaStock <noreply@nexastock.local>

# File de traitements prédictifs (les URL Docker ci-dessous sont recommandées).
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2
# Cache partagé et limitation de débit. Utilisez une base Redis distincte du broker Celery.
DJANGO_CACHE_URL=redis://redis:6379/2
API_LOGIN_RATE=10/minute
API_SENSITIVE_WRITE_RATE=60/minute
API_NUM_PROXIES=0
WEB_LOGIN_MAX_ATTEMPTS=8
WEB_LOGIN_WINDOW_SECONDS=300
# Activez uniquement derrière un proxy de confiance (Railway, par exemple).
RATE_LIMIT_TRUST_X_FORWARDED_FOR=false
# Active uniquement les tâches périodiques validées. Les lancements manuels restent disponibles.
CELERY_AUTOMATION_ENABLED=false
# Refuse une prévision si la dernière vente du produit dépasse ce retard.
FORECAST_MAX_DATA_AGE_DAYS=3
FORECAST_CHAMPION_MIN_IMPROVEMENT=5
