{
  "name": "sales-predictive-analytics-ui",
  "private": true,
  "scripts": {
    "css:build": "tailwindcss -i ./backend/static/src/tailwind.css -o ./backend/static/css/tailwind.css --minify",
    "css:watch": "tailwindcss -i ./backend/static/src/tailwind.css -o ./backend/static/css/tailwind.css --watch=always",
    "icons:build": "mkdir -p ./backend/static/vendor/lucide && cp ./node_modules/lucide/dist/umd/lucide.min.js ./backend/static/vendor/lucide/lucide.min.js",
    "assets:build": "npm run css:build && npm run icons:build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "lucide": "^1.30.0"
  }
}
